# Generated by install-persistent.sh. Grants the active seat user access only to
# the selected mouse interfaces and gives each one a stable name, under a single
# directory, across reconnects. One rule line per configured mouse; the
# forwarder monitors every entry in /dev/input/wsf, so switching between mice
# mid-session keeps working.
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", ATTRS{name}=="@DEVICE_NAME@", TAG+="uaccess", SYMLINK+="input/wsf/%k"
